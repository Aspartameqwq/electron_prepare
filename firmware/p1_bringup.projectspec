<?xml version="1.0" encoding="UTF-8"?>
<!--
  P2 工程 projectspec（保留工程标识供 build/flash 脚本使用；单 main + BSP + 调度验收）
  用途：CCS Theia 导入 / ccs-server-cli projectCreate+projectBuild headless 构建。
  说明：
    - 工程就地引用 firmware/ 下源文件（action="link"，不复制），目录即仓库结构；
    - SysConfig 由工程构建自动调用（sysConfigBuildOptions），产物进 Debug/syscfg；
    - control.syscfg 为唯一事实源；Debug/ 构建产物不入 git（.gitignore）。
    - warning 门禁（选项均经本机锁定工具链实测验证）：
        compiler 用 Werror，经 firmware/gate.opt 响应文件传入（内容仅一行 -Werror；
        tiarmclang 的 @file 不支持注释行）。为何用响应文件：CCS TICLANG 工程模型会把
        projectspec compilerBuildOptions 中的裸 Werror 丢弃（tooldef 将其建模为布尔
        WERRORALL 与列表 Werror= 两种形式），而 @file 由 tiarmclang 自身展开、与既有
        device.opt 同机制，实测 warning 转 error 退出码 1；
        linker 用 emit_warnings_as_errors（tiarmlnk help 确认别名 pdew "Treat warnings as
        errors"，经 Wl, 前缀透传成功，实测同类诊断 warning 转 error 且不产出 .out）。
        scripts/build.ps1 的日志解析仅作第二层审计，非唯一 warning 门禁。
-->
<projectSpec>
    <applicability>
        <when>
            <context deviceFamily="ARM" deviceId="MSPM0G3507"/>
        </when>
    </applicability>

    <project
        title="P2 timebase and scheduler"
        name="firmware_p1_bringup"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="MSPM0G3507"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM0-SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/app
            -I${PROJECT_ROOT}/config
            -I${PROJECT_ROOT}/middleware
            -std=c11
            -I${PROJECT_ROOT}/${ConfigName}/syscfg
            -O2
            @${PROJECT_ROOT}/${ConfigName}/syscfg/device.opt
            @${PROJECT_ROOT}/gate.opt
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -gdwarf-3
            -mcpu=cortex-m0plus
            -march=thumbv6m
            -mfloat-abi=soft
            -mthumb
            -Wall
            -Wextra
        "
        linkerBuildOptions="
            -lp2_runtime.opt
            -ldevice.cmd.genlibs
            -L${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            -L${PROJECT_BUILD_DIR}/syscfg
            -Wl,--rom_model
            -Wl,--warn_sections
            -Wl,--emit_warnings_as_errors
            -Wl,--diag_suppress=10234-D
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        sysConfigBuildOptions="
            --output syscfg
            --product ${COM_TI_MSPM0_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        description="P2 timebase and portable scheduler acceptance (single main, no actuators)">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>

        <!-- 应用源码（就地引用并保留目录，避免同一源码形成根目录别名）。
             p2_runtime.opt 在生成 linker.cmd 之后加载，覆盖生成默认栈；map 验证实际大小。 -->
        <file path="app/main.c" targetDirectory="app" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="app/app_config.h" targetDirectory="app" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="app/app_dispatch.c" targetDirectory="app" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="app/tests/test_scheduler.c" targetDirectory="app/tests" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="board/bsp/board.c" targetDirectory="board/bsp" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="board/bsp/timebase.c" targetDirectory="board/bsp" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="board/bsp/interrupts.c" targetDirectory="board/bsp" openOnCreation="false" excludeFromBuild="false" action="link"/>
        <file path="middleware/scheduler.c" targetDirectory="middleware" openOnCreation="false" excludeFromBuild="false" action="link"/>

        <!-- 明确排除 P3 预研实现，防 CCS 自动扫描把其计入 P2 验证范围。 -->
        <file path="middleware/ring_buffer.c" targetDirectory="middleware" excludeFromBuild="true" action="link"/>
        <file path="middleware/frame_codec.c" targetDirectory="middleware" excludeFromBuild="true" action="link"/>

        <!-- 唯一事实源 -->
        <file path="control.syscfg" openOnCreation="true" excludeFromBuild="false" action="link"/>
    </project>
</projectSpec>
